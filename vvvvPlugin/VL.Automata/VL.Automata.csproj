<Project Sdk="Microsoft.NET.Sdk">
  <!--
    vvvv gamma library for the Automata FSM node — a port of the cables op
    Ops.Local.Automata.

    Two targets in one package, NuGet picks the matching one:
    - net8.0-windows for vvvv gamma 7.x (and earlier .NET 8 versions): the node
      outputs a VL.Skia ILayer directly (it wraps the ImGui editor widget with
      VL.ImGui.ToSkiaLayer in C#), and gamma 7's VL.ImGui.Skia / VL.Skia are
      net8.0-windows only.
    - net10.0 for vvvv gamma 8.0, whose VL packages are plain net10.0. Nothing here
      is Windows specific, so macOS and Linux exports of gamma 8.0 can restore it.
    EnableWindowsTargeting lets this still build on non-Windows (dev on macOS) via
    the Windows targeting packs.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- vvvv reads the doc file for tooltips; we don't doc every DTO member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <!-- vvvv gamma 7.x packages for net8.0-windows, gamma 8.0 packages for net10.0 -->
    <VLVersion Condition="'$(TargetFramework)' == 'net8.0-windows'">2025.7.4</VLVersion>
    <VLVersion Condition="'$(TargetFramework)' == 'net10.0'">2026.8.0-0374-ga13b8c2c14</VLVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="VL.Core" Version="$(VLVersion)" />
    <PackageReference Include="VL.ImGui" Version="$(VLVersion)" />
    <PackageReference Include="VL.ImGui.Skia" Version="$(VLVersion)" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="VL.Core" />
    <Using Include="VL.Core.Import" />
  </ItemGroup>
</Project>